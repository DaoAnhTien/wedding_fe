{
  "functions": {
    "api/invitation.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "/moi/([^/]+)",
      "dest": "/api/invitation?guest=$1&invitationPath=1"
    },
    {
      "src": "/",
      "dest": "/api/invitation"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}