{
  "functions": {
    "api/invitation.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "guest" }],
      "destination": "/api/invitation"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
